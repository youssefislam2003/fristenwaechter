# Copy to .env and fill in real secrets. NEVER commit .env.
# ── database role passwords (compose wires these into the DSNs) ──
POSTGRES_PASSWORD=change-me-postgres
MIGRATION_ADMIN_PASSWORD=change-me-migadmin
APP_USER_PASSWORD=change-me-appuser
APP_JOBS_PASSWORD=change-me-appjobs

# ── app secrets ──
SECRET_KEY=generate-a-long-random-string
BASE_URL=http://localhost:8000

# ── EU notification providers ──
BREVO_API_KEY=your-brevo-key
SEVEN_IO_API_KEY=your-seven-io-key

# ── ops ──
HEARTBEAT_URL=            # e.g. https://hc-ping.com/<uuid> (leave blank locally)
SMS_MONTHLY_CAP_PER_COMPANY=200

# ── backup (scripts/backup.sh) ──
RESTIC_REPOSITORY=        # e.g. sftp:backup@host:/srv/restic/fristen
RESTIC_PASSWORD=          # restic repo encryption password
